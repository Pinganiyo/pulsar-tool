<ui:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Windowing"
        xmlns:vm="using:Pulsar.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="Pulsar.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="620"
        MinWidth="760" MinHeight="520"
        Title="PULSAR Revived"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="220,*">

        <!-- Left navigation rail -->
        <Border Grid.Column="0"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,22,20,18" Spacing="2">
                    <TextBlock Text="PULSAR" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Co-op control" FontSize="12" Opacity="0.55" />
                </StackPanel>

                <!-- Nav items -->
                <ListBox Grid.Row="1"
                         Classes="NavList"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewModelBase">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Connection status pill at the bottom of the rail -->
                <Border Grid.Row="2" Margin="16,12,16,16"
                        Classes="StatusPill"
                        Classes.Connected="{Binding IsConnected}"
                        Classes.Disconnected="{Binding !IsConnected}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="White" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Page host (with the update banner pinned above the page content) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Update banner (Phase 5): dismissible, only shown when an update exists -->
            <Border Grid.Row="0"
                    IsVisible="{Binding UpdateAvailable}"
                    Background="{DynamicResource AccentControlElevationBorderBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="&#xE896;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding UpdateText}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="{Binding UpdateButtonText}" Classes="accent"
                            Margin="12,0,8,0"
                            Command="{Binding DownloadUpdateCommand}" />
                    <Button Grid.Column="3" Content="&#xE711;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            ToolTip.Tip="Dismiss"
                            Command="{Binding DismissUpdateCommand}" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Margin="0"
                            Content="{Binding SelectedPage}" />
        </Grid>
    </Grid>
</ui:AppWindow>
