<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PulsarCompanion</RootNamespace>
    <AssemblyName>PulsarCompanion</AssemblyName>
    <!-- Version-resource metadata (AV reputation: avoid a blank FileDescription/Company). -->
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <Company>PULSAR</Company>
    <Product>PULSAR</Product>
    <Authors>PULSAR</Authors>
    <AssemblyTitle>PULSAR companion</AssemblyTitle>
    <Description>PULSAR companion service (SpacetimeDB lobby client for the PULSAR tool).</Description>
    <Copyright>Copyright (c) 2026 PULSAR</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.5.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- proximity voice: WASAPI capture/render + managed Opus codec -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="1.1.7" />
  </ItemGroup>

</Project>
